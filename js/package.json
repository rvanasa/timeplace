    "prepack": "npm run build"
  },
  "dependencies": {
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
