{
  "name": "timeplace",
  "version": "0.1.0",
  "description": "Parse and format timeplace lines: a moment, a place, and a comment.",
  "author": "Ryan Vandersmith <ryanvandersmith@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
